# Example site configuration for slurm-quota-serve.
#
# Parameter reference is in conf/serve.yml (installed as
# /usr/share/slurm-quota/conf/serve.yml).

[authentication]
method=ldap

[ldap]
uri=ldap://localhost
user_base=ou=people,dc=example,dc=org
group_base=ou=groups,dc=example,dc=org

# JWT-only authentication (tokens issued by slurm-quota-token as root):
#
# [authentication]
# method=jwt

[authorization]
admins=
  admin-user

# Native HTTPS (optional; cert and key are required when enabled):
#
# [tls]
# enabled=true
# cert=/etc/slurm-quota/tls/cert.pem
# key=/etc/slurm-quota/tls/key.pem

# [log]
# log_flags=
#   slurm_quota
# debug_flags=
#   slurm_quota
